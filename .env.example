# Brocantor — configuration locale
# Copier ce fichier vers .env puis renseigner les valeurs.
# ⚠️ Ce fichier-ci est versionné : ne JAMAIS y coller une vraie clé.

# Modèle vision utilisé pour l'analyse (T03), au format LiteLLM
# "<provider>/<modele>". C'est LUI qui décide du provider appelé :
#   openai/gpt-5              → utilise OPENAI_API_KEY
#   anthropic/claude-sonnet-5 → utilise ANTHROPIC_API_KEY
AI_MODEL=openai/gpt-5

# Clés API. Seule celle du provider visé par AI_MODEL est nécessaire ; les
# autres peuvent rester vides. Sans la bonne clé, le worker IA démarre mais
# laisse les produits en état "depose" (pas d'analyse).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Répertoire de données (base SQLite + photos). Défaut : ./data
DATA_DIR=./data

# Port d'écoute de l'app. Défaut : 8377
PORT=8377
