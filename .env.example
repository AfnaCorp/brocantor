# Brocantor — configuration locale
# Copier ce fichier vers .env puis renseigner les valeurs.

# Clé API Anthropic (console.anthropic.com). Sans elle, le worker IA (T03)
# démarre mais laisse les produits en état "depose" (pas d'analyse).
ANTHROPIC_API_KEY=

# Modèle vision utilisé pour l'analyse (T03).
CLAUDE_MODEL=claude-sonnet-5

# Répertoire de données (base SQLite + photos). Défaut : ./data
DATA_DIR=./data

# Port d'écoute de l'app. Défaut : 8377
PORT=8377
